# Sunucudaki PostgreSQL bağlantısı
DATABASE_URL=postgres://kullanici:sifre@localhost:5432/ilan_rehberi

# Yönetim paneli tek ortak şifresi (kendiniz belirleyin, güçlü olsun)
ADMIN_PASSWORD=degistir-beni-guclu-bir-sifre

# Oturum çerezini imzalamak için 32+ karakter rastgele metin
SESSION_SECRET=degistir-beni-32-karakterden-uzun-rastgele-metin

# Uygulama portu (Plesk genelde kendisi atar)
PORT=3000

# Sitenin tam adresi (SEO/canonical için)
SITE_URL=https://alanadiniz.com
